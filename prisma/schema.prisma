generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model banners {
  banner_id     Int       @id @default(autoincrement())
  title         String    @db.VarChar(150)
  image_url     String
  link_url      String?
  position      String?   @default("home_top") @db.VarChar(30)
  display_order Int?      @default(0)
  start_date    DateTime? @db.Timestamptz(6)
  end_date      DateTime? @db.Timestamptz(6)
  is_active     Boolean?  @default(true)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@index([is_active, start_date, end_date], map: "idx_banners_active")
  @@index([position], map: "idx_banners_position")
}

model categories {
  category_id      Int          @id @default(autoincrement())
  category_name    String       @db.VarChar(50)
  description      String?
  parent_id        Int?
  slug             String       @unique @db.VarChar(60)
  is_active        Boolean?     @default(true)
  created_at       DateTime?    @default(now()) @db.Timestamptz(6)
  categories       categories?  @relation("categoriesTocategories", fields: [parent_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  other_categories categories[] @relation("categoriesTocategories")
  products         products[]

  @@index([parent_id], map: "idx_categories_parent")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_items {
  item_id      Int      @id @default(autoincrement())
  order_id     Int
  product_id   Int
  quantity     Int
  unit_price   Decimal  @db.Decimal(12, 2)
  discount_pct Decimal? @default(0) @db.Decimal(4, 2)
  subtotal     Decimal? @default(dbgenerated("(((quantity)::numeric * unit_price) * ((1)::numeric - (discount_pct / (100)::numeric)))")) @db.Decimal(14, 2)
  orders       orders   @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)
  products     products @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([order_id, product_id], map: "oi_order_product_uk")
  @@index([order_id], map: "idx_order_items_order")
  @@index([product_id], map: "idx_order_items_product")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  order_id         Int           @id @default(autoincrement())
  customer_name    String        @db.VarChar(100)
  customer_email   String        @db.VarChar(100)
  customer_phone   String?       @db.VarChar(20)
  shipping_address String
  status           String?       @default("pending") @db.VarChar(20)
  total_amount     Decimal?      @default(0) @db.Decimal(14, 2)
  discount_amount  Decimal?      @default(0) @db.Decimal(14, 2)
  shipping_fee     Decimal?      @default(0) @db.Decimal(10, 2)
  note             String?
  ordered_at       DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?     @default(now()) @db.Timestamptz(6)
  order_items      order_items[]

  @@index([customer_email], map: "idx_orders_email")
  @@index([status], map: "idx_orders_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  product_id     Int           @id @default(autoincrement())
  product_name   String        @db.VarChar(150)
  description    String?
  slug           String        @unique @db.VarChar(170)
  sku            String        @unique @db.VarChar(50)
  category_id    Int
  supplier_id    Int?
  price          Decimal       @db.Decimal(12, 2)
  cost_price     Decimal?      @db.Decimal(12, 2)
  stock_quantity Int?          @default(0)
  min_stock      Int?          @default(5)
  weight_kg      Decimal?      @db.Decimal(6, 2)
  is_active      Boolean?      @default(true)
  created_at     DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?     @default(now()) @db.Timestamptz(6)
  order_items    order_items[]
  categories     categories    @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  suppliers      suppliers?    @relation(fields: [supplier_id], references: [supplier_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([category_id], map: "idx_products_category")
  @@index([sku], map: "idx_products_sku")
  @@index([slug], map: "idx_products_slug")
  @@index([supplier_id], map: "idx_products_supplier")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model suppliers {
  supplier_id   Int        @id @default(autoincrement())
  supplier_name String     @db.VarChar(100)
  contact_name  String?    @db.VarChar(60)
  email         String     @unique(map: "sup_email_uk") @db.VarChar(100)
  phone         String?    @db.VarChar(20)
  address       String?    @db.VarChar(200)
  country       String?    @db.VarChar(50)
  rating        Decimal?   @db.Decimal(2, 1)
  is_active     Boolean?   @default(true)
  created_at    DateTime?  @default(now()) @db.Timestamptz(6)
  products      products[]
}
